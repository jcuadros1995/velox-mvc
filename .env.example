# Local development configuration.
# Copy this file to .env. Never commit the real .env file.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/velox-mvc
APP_FORCE_HTTPS=false

# The repository SQL dump creates the database named velox_core.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velox_core

# Default XAMPP MariaDB configuration. If you assigned a MySQL password,
# enter it below. Empty passwords are permitted ONLY for local root.
DB_USER=root
DB_PASSWORD=

# Keep payment credentials empty locally until sandbox credentials are configured.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
