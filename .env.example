# Local development configuration.
# Copy this file to .env. Never commit the real .env file.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/velox-mvc
APP_FORCE_HTTPS=false

# The SQL dump database name is velox_core (MariaDB 10.4 / MySQL-compatible).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velox_core

# Default XAMPP MariaDB configuration. This assumes root has no password.
# For any other account or environment, set both DB_USER and DB_PASSWORD.
DB_USER=root
DB_PASSWORD=

# Keep payment credentials empty locally until sandbox credentials are configured.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
