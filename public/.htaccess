<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la petición no es un archivo o directorio real dentro de /public
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todo a index.php pasando la ruta limpia en $_GET['url']
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

